{
  "name": "up",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint && oxfmt --check .",
    "fix": "oxfmt .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "db:migrate:local": "wrangler d1 migrations apply up --local",
    "db:migrate:remote": "wrangler d1 migrations apply up --remote",
    "db:seed": "bun scripts/seed.ts",
    "admin:grant": "bun scripts/admin-grant.ts",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/geist-pixel": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "hono": "^4.13.21",
    "kysely": "^0.29.9",
    "kysely-d1": "^0.4.0",
    "maplibre-gl": "^6.19.0",
    "micromark": "^4.0.3",
    "preact": "^11.2.0",
    "preact-render-to-string": "^6.8.3",
    "satori": "0.33.5",
    "three": "^0.187.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/workers-types": "^5.20261124.2",
    "@fontsource/geist": "^5.3.0",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/dom": "^10.4.2",
    "@types/bun": "^1.4.5",
    "@types/three": "^0.187.0",
    "happy-dom": "^21.0.4",
    "miniflare": "^4.20260730.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.168.0"
  }
}
